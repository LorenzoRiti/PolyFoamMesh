{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "CFMesh-AutoGUI Design System",
  "version": "1.0.0",
  "description": "Commercial-grade design tokens for the CFMesh-AutoGUI desktop app (PySide6 / Qt 6.7+).",
  "created": "2026-07-07",
  "stack": {
    "framework": "PySide6 (Qt 6.7+)",
    "language": "Python 3.11+",
    "styling": "QSS (Qt Style Sheets) with Python token module",
    "platform": "Windows / macOS / Linux desktop"
  },
  "colorModes": ["light", "dark", "system"],
  "tokens": {
    "color": {
      "primary": {
        "50":  "#eff6ff",
        "100": "#dbeafe",
        "200": "#bfdbfe",
        "300": "#93c5fd",
        "400": "#60a5fa",
        "500": "#3b82f6",
        "600": "#2563eb",
        "700": "#1d4ed8",
        "800": "#1e40af",
        "900": "#1e3a8a",
        "950": "#172554"
      },
      "secondary": {
        "50":  "#f5f3ff",
        "100": "#ede9fe",
        "200": "#ddd6fe",
        "300": "#c4b5fd",
        "400": "#a78bfa",
        "500": "#8b5cf6",
        "600": "#7c3aed",
        "700": "#6d28d9",
        "800": "#5b21b6",
        "900": "#4c1d95",
        "950": "#2e1065"
      },
      "accent": {
        "50":  "#ecfeff",
        "100": "#cffafe",
        "200": "#a5f3fc",
        "300": "#67e8f9",
        "400": "#22d3ee",
        "500": "#06b6d4",
        "600": "#0891b2",
        "700": "#0e7490",
        "800": "#155e75",
        "900": "#164e63"
      },
      "neutral": {
        "50":  "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a",
        "950": "#020617"
      },
      "semantic": {
        "success":     "#16a34a",
        "successLight":"#22c55e",
        "warning":     "#f59e0b",
        "warningLight":"#fbbf24",
        "error":       "#dc2626",
        "errorLight":  "#ef4444",
        "info":        "#2563eb"
      }
    },
    "typography": {
      "fontFamily": {
        "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
        "mono": "'Cascadia Code', 'JetBrains Mono', 'Fira Code', Consolas, 'Courier New', monospace"
      },
      "fontSize": {
        "xs":   "11px",
        "sm":   "12px",
        "base": "13px",
        "md":   "14px",
        "lg":   "16px",
        "xl":   "18px",
        "2xl":  "22px",
        "3xl":  "28px"
      },
      "fontWeight": {
        "normal":   "400",
        "medium":   "500",
        "semibold": "600",
        "bold":     "700"
      },
      "lineHeight": {
        "tight":   "1.2",
        "normal":  "1.45",
        "relaxed": "1.6"
      }
    },
    "spacing": {
      "0":  "0",
      "1":  "4px",
      "2":  "8px",
      "3":  "12px",
      "4":  "16px",
      "5":  "20px",
      "6":  "24px",
      "7":  "32px",
      "8":  "40px",
      "9":  "48px",
      "10": "64px"
    },
    "radius": {
      "none":   "0px",
      "sm":     "3px",
      "base":   "4px",
      "md":     "6px",
      "lg":     "8px",
      "xl":     "12px",
      "2xl":    "16px",
      "pill":   "9999px",
      "circle": "50%"
    },
    "border": {
      "none": "0px",
      "1":    "1px",
      "2":    "2px",
      "3":    "3px"
    },
    "shadow": {
      "none":  "none",
      "xs":    "0 1px 2px 0 rgba(0,0,0,0.05)",
      "sm":    "0 1px 3px 0 rgba(0,0,0,0.10), 0 1px 2px 0 rgba(0,0,0,0.06)",
      "md":    "0 4px 6px -1px rgba(0,0,0,0.10), 0 2px 4px -1px rgba(0,0,0,0.06)",
      "lg":    "0 10px 15px -3px rgba(0,0,0,0.10), 0 4px 6px -2px rgba(0,0,0,0.05)",
      "xl":    "0 20px 25px -5px rgba(0,0,0,0.10), 0 10px 10px -5px rgba(0,0,0,0.04)",
      "inner": "inset 0 2px 4px 0 rgba(0,0,0,0.06)"
    },
    "duration": {
      "instant": "0ms",
      "fast":    "120ms",
      "normal":  "200ms",
      "slow":    "320ms",
      "slower":  "500ms"
    },
    "easing": {
      "default":  "cubic-bezier(0.4, 0, 0.2, 1)",
      "in":       "cubic-bezier(0.4, 0, 1, 1)",
      "out":      "cubic-bezier(0.0, 0, 0.2, 1)",
      "inOut":    "cubic-bezier(0.4, 0, 0.2, 1)",
      "linear":   "linear"
    },
    "zIndex": {
      "base":     "0",
      "raised":   "10",
      "dropdown": "100",
      "sticky":   "200",
      "modal":    "1000",
      "tooltip":  "2000",
      "toast":    "3000"
    },
    "component": {
      "button": {
        "heightSm":   "24px",
        "heightMd":   "32px",
        "heightLg":   "40px",
        "minWidth":   "64px",
        "paddingX":   "12px",
        "paddingXSm": "8px"
      },
      "input": {
        "height":   "32px",
        "paddingX": "10px",
        "borderWidth": "1px"
      },
      "panel": {
        "padding":  "12px",
        "headerHeight": "32px"
      },
      "toolbar": {
        "height":     "36px",
        "paddingX":   "8px",
        "iconSize":   "16px"
      },
      "statusbar": {
        "height": "24px"
      },
      "menu": {
        "itemHeight": "24px",
        "paddingX":   "12px"
      },
      "dialog": {
        "minWidth":  "320px",
        "padding":   "20px",
        "buttonGap": "8px"
      },
      "progressbar": {
        "height":      "6px",
        "borderRadius":"3px"
      }
    }
  },
  "semantic": {
    "light": {
      "bgBase":     "{color.neutral.50}",
      "bgSubtle":   "{color.neutral.100}",
      "bgMuted":    "{color.neutral.200}",
      "bgElevated": "#ffffff",
      "fgDefault":  "{color.neutral.900}",
      "fgMuted":    "{color.neutral.600}",
      "fgSubtle":   "{color.neutral.500}",
      "fgOnAccent": "#ffffff",
      "border":     "{color.neutral.200}",
      "borderStrong":"{color.neutral.300}",
      "accent":     "{color.primary.600}",
      "accentHover":"{color.primary.700}",
      "accentFg":   "#ffffff",
      "success":    "{color.semantic.success}",
      "warning":    "{color.semantic.warning}",
      "error":      "{color.semantic.error}",
      "info":       "{color.semantic.info}",
      "selection":  "{color.primary.100}",
      "selectionFg":"{color.primary.900}"
    },
    "dark": {
      "bgBase":     "{color.neutral.950}",
      "bgSubtle":   "{color.neutral.900}",
      "bgMuted":    "{color.neutral.800}",
      "bgElevated": "{color.neutral.800}",
      "fgDefault":  "{color.neutral.50}",
      "fgMuted":    "{color.neutral.400}",
      "fgSubtle":   "{color.neutral.500}",
      "fgOnAccent": "#ffffff",
      "border":     "{color.neutral.800}",
      "borderStrong":"{color.neutral.700}",
      "accent":     "{color.primary.500}",
      "accentHover":"{color.primary.400}",
      "accentFg":   "#ffffff",
      "success":    "{color.semantic.successLight}",
      "warning":    "{color.semantic.warningLight}",
      "error":      "{color.semantic.errorLight}",
      "info":       "{color.primary.400}",
      "selection":  "{color.primary.800}",
      "selectionFg":"{color.primary.100}"
    }
  },
  "outputFormats": [
    "python:src/cfmesh_autogui/gui/design_tokens.py",
    "json:.ui-design/tokens.json",
    "qss-light:.ui-design/qss/light.qss",
    "qss-dark:.ui-design/qss/dark.qss",
    "markdown:.ui-design/design-system.md",
    "components:.ui-design/components.md"
  ]
}
