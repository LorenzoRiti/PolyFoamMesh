/* ============================================================================
   CFMesh-AutoGUI — Dark Theme (BaramMesh-inspired professional style)
   ============================================================================ */

/* -------- Global base ---------------------------------------------------- */
QWidget {
    background-color: #1c1c1c;
    color: #e5e5e5;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                 "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    selection-background-color: #d97757;
    selection-color: #ffffff;
}

/* -------- QMainWindow + central area ------------------------------------ */
QMainWindow {
    background-color: #181818;
}
QMainWindow::separator {
    background: #2d2d2d;
    width: 1px;
    height: 1px;
}

/* -------- QMenuBar + QMenu ---------------------------------------------- */
QMenuBar {
    background-color: #202020;
    color: #e5e5e5;
    border-bottom: 1px solid #2d2d2d;
    padding: 2px 4px;
    font-size: 12px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 14px;
    border-radius: 4px;
    margin: 1px 0;
}
QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #2a2a2a;
    color: #eea283;
}
QMenu {
    background-color: #262626;
    border: 1px solid #3f3f3f;
    border-radius: 6px;
    padding: 4px;
    color: #e5e5e5;
}
QMenu::item {
    padding: 6px 32px 6px 14px;
    border-radius: 4px;
    min-height: 22px;
}
QMenu::item:selected {
    background-color: #d97757;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #595959;
}
QMenu::separator {
    height: 1px;
    background: #3f3f3f;
    margin: 4px 10px;
}

/* -------- Buttons ------------------------------------------------------- */
QPushButton {
    background-color: #2a2a2a;
    color: #e5e5e5;
    border: 1px solid #3f3f3f;
    border-radius: 5px;
    padding: 5px 14px;
    min-height: 22px;
    min-width: 60px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #3a3a3a;
    border-color: #474747;
}
QPushButton:pressed {
    background-color: #232323;
}
QPushButton:disabled {
    background-color: #202020;
    color: #454545;
    border-color: #2d2d2d;
}
QPushButton:default {
    background-color: #d97757;
    color: #ffffff;
    border-color: #d97757;
    font-weight: 600;
}
QPushButton:default:hover {
    background-color: #e2916f;
    border-color: #e2916f;
}
QPushButton:default:pressed {
    background-color: #b85c3e;
}

/* -------- Inputs (LineEdit, SpinBox, DoubleSpinBox, ComboBox) ----------- */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #232323;
    color: #e5e5e5;
    border: 1px solid #3f3f3f;
    border-radius: 5px;
    padding: 3px 8px;
    min-height: 22px;
    selection-background-color: #d97757;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #d97757;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #202020;
    color: #454545;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    background: #2a2a2a;
    border: none;
    width: 18px;
    border-left: 1px solid #3f3f3f;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: #2a2a2a;
    border: none;
    width: 18px;
    border-left: 1px solid #3f3f3f;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #3a3a3a;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #a3a3a3;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #a3a3a3;
}

QComboBox {
    background-color: #232323;
    color: #e5e5e5;
    border: 1px solid #3f3f3f;
    border-radius: 5px;
    padding: 3px 28px 3px 8px;
    min-height: 22px;
}
QComboBox:focus { border-color: #d97757; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #3f3f3f;
    background: #2a2a2a;
}
QComboBox::down-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #a3a3a3;
}
QComboBox QAbstractItemView {
    background: #262626;
    border: 1px solid #3f3f3f;
    border-radius: 4px;
    outline: 0;
    padding: 2px;
    color: #e5e5e5;
}
QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    border-radius: 3px;
    min-height: 22px;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #d97757;
    color: #ffffff;
}

/* -------- Checkbox / Radio --------------------------------------------- */
QCheckBox, QRadioButton {
    spacing: 7px;
    color: #e5e5e5;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: #232323;
    border: 1px solid #474747;
}
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #d97757;
}
QCheckBox::indicator:checked {
    background: #d97757;
    border-color: #d97757;
}
QRadioButton::indicator:checked {
    background: #d97757;
    border-color: #d97757;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background: #202020;
    border-color: #2d2d2d;
}
QCheckBox:disabled, QRadioButton:disabled { color: #454545; }

/* -------- GroupBox ----------------------------------------------------- */
QGroupBox {
    background-color: #232323;
    border: 1px solid #2d2d2d;
    border-radius: 7px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
    font-size: 12px;
    color: #e5e5e5;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 1px 10px;
    color: #e2916f;
    background: #232323;
    left: 8px;
}

/* -------- QListWidget -------------------------------------------------- */
QListWidget {
    background-color: #181818;
    color: #e5e5e5;
    border: 1px solid #2d2d2d;
    border-radius: 5px;
    padding: 3px;
    outline: 0;
}
QListWidget::item {
    padding: 5px 8px;
    border-radius: 3px;
}
QListWidget::item:selected {
    background-color: #5a3a2c;
    color: #eea283;
}
QListWidget::item:hover {
    background-color: #262626;
}
QListWidget::item:selected:active {
    background-color: #d97757;
    color: #ffffff;
}

/* -------- QTextEdit / QPlainTextEdit ----------------------------------- */
QTextEdit, QPlainTextEdit {
    background-color: #141414;
    color: #d4d4d4;
    border: 1px solid #2d2d2d;
    border-radius: 5px;
    padding: 5px;
    selection-background-color: #d97757;
    selection-color: #ffffff;
    font-family: "Cascadia Code", "JetBrains Mono", "Fira Code",
                 Consolas, "Courier New", monospace;
    font-size: 11px;
}

/* -------- QScrollBar ---------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3f3f3f;
    min-height: 30px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #5a5a5a; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3f3f3f;
    min-width: 30px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover { background: #5a5a5a; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* -------- QProgressBar ------------------------------------------------- */
QProgressBar {
    background-color: #2d2d2d;
    border: none;
    border-radius: 3px;
    text-align: center;
    font-size: 10px;
    min-height: 6px;
    max-height: 6px;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #d97757;
    border-radius: 3px;
}

/* -------- QStatusBar --------------------------------------------------- */
QStatusBar {
    background-color: #181818;
    color: #9a9a9a;
    border-top: 1px solid #2d2d2d;
    font-size: 11px;
    min-height: 22px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel {
    color: #9a9a9a;
    font-size: 11px;
}

/* -------- QToolTip ----------------------------------------------------- */
QToolTip {
    background-color: #e5e5e5;
    color: #1c1c1c;
    border: 1px solid #a3a3a3;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* -------- QSplitter ---------------------------------------------------- */
QSplitter::handle { background: #2d2d2d; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover { background: #d97757; }

/* -------- QDialog / QMessageBox ---------------------------------------- */
QDialog {
    background-color: #202020;
}
QMessageBox {
    background-color: #1c1c1c;
}
QMessageBox QLabel {
    color: #e5e5e5;
    min-width: 280px;
    font-size: 12px;
}
QMessageBox QPushButton {
    min-width: 80px;
}

/* -------- Tab widget --------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #2d2d2d;
    border-radius: 5px;
    background: #232323;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #9a9a9a;
    padding: 7px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 1px;
    font-size: 12px;
}
QTabBar::tab:selected {
    color: #e2916f;
    border-bottom: 2px solid #d97757;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: #e5e5e5;
    background: #2a2a2a;
}

/* -------- Status banner pills (role-based) ----------------------------- */
QLabel[role="status-pass"]   { background: #22c55e; color: #022c22; padding: 2px 10px; border-radius: 4px; font-weight: 700; font-size: 12px; }
QLabel[role="status-warn"]   { background: #fbbf24; color: #1f1300; padding: 2px 10px; border-radius: 4px; font-weight: 700; font-size: 12px; }
QLabel[role="status-fail"]   { background: #ef4444; color: #ffffff; padding: 2px 10px; border-radius: 4px; font-weight: 700; font-size: 12px; }
QLabel[role="status-neutral"]{ background: #6b7280; color: #ffffff; padding: 2px 10px; border-radius: 4px; font-weight: 700; font-size: 12px; }
