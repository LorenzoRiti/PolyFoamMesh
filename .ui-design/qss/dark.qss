/* ============================================================================
   PolyFoamMesh — Dark Theme (Fluent/ANSYS-inspired engineering-tool style)

   Restrained on purpose: flat corners, neutral greys, a single technical
   accent (ANSYS Workbench orange, already defined as ORANGE_500 in
   design_tokens.py — this file is the first to actually wire it into the
   QSS). No gradients, no glow, no candy-colored pills. The subject is the
   mesh data, not the chrome around it.
   ============================================================================ */

/* -------- Global base ---------------------------------------------------- */
QWidget {
    background-color: #1c1c1c;
    color: #e5e5e5;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                 "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    selection-background-color: #e37222;
    selection-color: #ffffff;
}

/* -------- QMainWindow + central area ------------------------------------ */
QMainWindow {
    background-color: #181818;
}
QMainWindow::separator {
    background: #2d2d2d;
    width: 1px;
    height: 1px;
}

/* -------- QMenuBar + QMenu ---------------------------------------------- */
QMenuBar {
    background-color: #1a1a1a;
    color: #e5e5e5;
    border-bottom: 1px solid #3c3c3c;
    padding: 2px 4px;
    font-size: 12px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 14px;
    border-radius: 0px;
    margin: 0;
}
QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #2d2d2d;
    color: #f08c4a;
}
QMenu {
    background-color: #232323;
    border: 1px solid #3c3c3c;
    border-radius: 0px;
    padding: 2px;
    color: #e5e5e5;
}
QMenu::item {
    padding: 6px 32px 6px 14px;
    border-radius: 0px;
    min-height: 22px;
}
QMenu::item:selected {
    background-color: #e37222;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #595959;
}
QMenu::separator {
    height: 1px;
    background: #3c3c3c;
    margin: 4px 8px;
}

/* -------- Buttons ------------------------------------------------------- */
QPushButton {
    background-color: #2a2a2a;
    color: #e5e5e5;
    border: 1px solid #454545;
    border-radius: 2px;
    padding: 5px 14px;
    min-height: 22px;
    min-width: 60px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #333333;
    border-color: #565656;
}
QPushButton:pressed {
    background-color: #202020;
}
QPushButton:disabled {
    background-color: #1e1e1e;
    color: #4a4a4a;
    border-color: #2d2d2d;
}
QPushButton:default {
    background-color: #e37222;
    color: #ffffff;
    border-color: #e37222;
    font-weight: 600;
}
QPushButton:default:hover {
    background-color: #f08c4a;
    border-color: #f08c4a;
}
QPushButton:default:pressed {
    background-color: #c95a1a;
}

/* -------- Inputs (LineEdit, SpinBox, DoubleSpinBox, ComboBox) ----------- */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #202020;
    color: #e5e5e5;
    border: 1px solid #454545;
    border-radius: 2px;
    padding: 3px 8px;
    min-height: 22px;
    selection-background-color: #e37222;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #e37222;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #1e1e1e;
    color: #4a4a4a;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    background: #2a2a2a;
    border: none;
    width: 18px;
    border-left: 1px solid #454545;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: #2a2a2a;
    border: none;
    width: 18px;
    border-left: 1px solid #454545;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #333333;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #a3a3a3;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #a3a3a3;
}

QComboBox {
    background-color: #202020;
    color: #e5e5e5;
    border: 1px solid #454545;
    border-radius: 2px;
    padding: 3px 28px 3px 8px;
    min-height: 22px;
}
QComboBox:focus { border-color: #e37222; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #454545;
    background: #2a2a2a;
}
QComboBox::down-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #a3a3a3;
}
QComboBox QAbstractItemView {
    background: #232323;
    border: 1px solid #454545;
    border-radius: 0px;
    outline: 0;
    padding: 2px;
    color: #e5e5e5;
}
QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    border-radius: 0px;
    min-height: 22px;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #e37222;
    color: #ffffff;
}

/* -------- Checkbox / Radio --------------------------------------------- */
QCheckBox, QRadioButton {
    spacing: 7px;
    color: #e5e5e5;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    background: #202020;
    border: 1px solid #565656;
}
QCheckBox::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #e37222;
}
QCheckBox::indicator:checked {
    background: #e37222;
    border-color: #e37222;
}
QRadioButton::indicator:checked {
    background: #e37222;
    border-color: #e37222;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background: #1e1e1e;
    border-color: #2d2d2d;
}
QCheckBox:disabled, QRadioButton:disabled { color: #4a4a4a; }

/* -------- GroupBox ----------------------------------------------------- */
QGroupBox {
    background-color: #202020;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
    font-size: 12px;
    color: #e5e5e5;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 1px 10px;
    color: #f08c4a;
    background: #202020;
    left: 8px;
}

/* -------- QListWidget -------------------------------------------------- */
QListWidget {
    background-color: #181818;
    color: #e5e5e5;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    padding: 2px;
    outline: 0;
}
QListWidget::item {
    padding: 5px 8px;
    border-radius: 0px;
}
QListWidget::item:selected {
    background-color: #383838;
    color: #f08c4a;
}
QListWidget::item:hover {
    background-color: #262626;
}
QListWidget::item:selected:active {
    background-color: #e37222;
    color: #ffffff;
}

/* -------- QTextEdit / QPlainTextEdit ----------------------------------- */
QTextEdit, QPlainTextEdit {
    background-color: #141414;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    padding: 5px;
    selection-background-color: #e37222;
    selection-color: #ffffff;
    font-family: "Cascadia Code", "JetBrains Mono", "Fira Code",
                 Consolas, "Courier New", monospace;
    font-size: 11px;
}

/* -------- QScrollBar ---------------------------------------------------- */
QScrollBar:vertical {
    background: #181818;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3c3c3c;
    min-height: 30px;
    border-radius: 0px;
    margin: 0;
}
QScrollBar::handle:vertical:hover { background: #565656; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #181818;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3c3c3c;
    min-width: 30px;
    border-radius: 0px;
    margin: 0;
}
QScrollBar::handle:horizontal:hover { background: #565656; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* -------- QProgressBar ------------------------------------------------- */
QProgressBar {
    background-color: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-radius: 0px;
    text-align: center;
    font-size: 10px;
    min-height: 6px;
    max-height: 6px;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #e37222;
    border-radius: 0px;
}

/* -------- QStatusBar --------------------------------------------------- */
QStatusBar {
    background-color: #181818;
    color: #9a9a9a;
    border-top: 1px solid #3c3c3c;
    font-size: 11px;
    min-height: 22px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel {
    color: #9a9a9a;
    font-size: 11px;
}

/* -------- QToolTip ----------------------------------------------------- */
QToolTip {
    background-color: #e5e5e5;
    color: #1c1c1c;
    border: 1px solid #a3a3a3;
    border-radius: 0px;
    padding: 4px 8px;
    font-size: 11px;
}

/* -------- QSplitter ---------------------------------------------------- */
QSplitter::handle { background: #2d2d2d; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover { background: #e37222; }

/* -------- QDialog / QMessageBox ---------------------------------------- */
QDialog {
    background-color: #1a1a1a;
}
QMessageBox {
    background-color: #1c1c1c;
}
QMessageBox QLabel {
    color: #e5e5e5;
    min-width: 280px;
    font-size: 12px;
}
QMessageBox QPushButton {
    min-width: 80px;
}

/* -------- Tab widget --------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    border-radius: 0px;
    background: #202020;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #9a9a9a;
    padding: 7px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 1px;
    font-size: 12px;
}
QTabBar::tab:selected {
    color: #f08c4a;
    border-bottom: 2px solid #e37222;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: #e5e5e5;
    background: #262626;
}

/* -------- Status banner pills (role-based) -----------------------------
   Flat instrument-panel tags, not glossy pills: near-zero radius, a
   border instead of a glow, no oversaturated fills. */
/* Semantic token colors (design_tokens.*_LIGHT) wired into the pill text so
   the dark QSS palette and the Python role tokens can never drift. */
QLabel[role="status-pass"]   { background: #1c3324; color: #22c55e; border: 1px solid #2d5537; padding: 2px 10px; border-radius: 2px; font-weight: 600; font-size: 12px; }
QLabel[role="status-warn"]   { background: #332a14; color: #fbbf24; border: 1px solid #5c4a1f; padding: 2px 10px; border-radius: 2px; font-weight: 600; font-size: 12px; }
QLabel[role="status-fail"]   { background: #331a1a; color: #ef4444; border: 1px solid #5c2929; padding: 2px 10px; border-radius: 2px; font-weight: 600; font-size: 12px; }
QLabel[role="status-neutral"]{ background: #262626; color: #a3a3a3; border: 1px solid #3c3c3c; padding: 2px 10px; border-radius: 2px; font-weight: 600; font-size: 12px; }
